{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": ".", // <-- ADD THIS
    "paths": {
      // <-- AND THIS
      "@/*": ["./*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "**/*.ts",
    "**/*.tsx",
    "app/api/auth/login/route.js",
    "prisma/seed.js",
    "lib/prisma.js",
    "app/api/route.js",
    "app/api/users/[userId]/role/route.js",
    "app/api/hotels/route.js",
    "app/api/permissions/route.js",
    "app/api/roles/[roleId]/permissions/route.js",
    "app/api/roles/route.js"
, "app/admin/(protect)/owners/menu/page.tsx", "app/admin/(protect)/owners/online-orders/page.tsx"  ],
  "exclude": ["node_modules"]
}
