generator client {
  provider       = "prisma-client-js"
  output         = "../generated/prisma"
  driverAdapters = true
}

datasource db {
  provider = "postgresql"
}

// =========================================================
// IDENTITY / AUTH — single table for every human who logs in
// =========================================================

/// One login system for Super Admins, Hotel Owners, Branch Managers, and Staff.
/// Scope is determined by branch_id + role, not by which table the row lives in.
/// Hotel-owner-specific data (hotel_id, address) lives in hotel_owners, a 1-to-1
/// profile table — NOT a separate login system.
model users {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // --- scope ---
  hotel_id  String? @db.Uuid
  branch_id String? @db.Uuid // set for branch_manager + staff roles

  // --- role ---
  role_id String @db.Uuid

  // --- identity / credentials (union of what any role might use) ---
  full_name     String  @db.VarChar(150)
  email         String? @unique @db.VarChar(150)
  phone         String? @unique @db.VarChar(30)
  username      String? @db.VarChar(50)
  password_hash String?
  pin_code      String? @db.VarChar(10) // fast POS login for waiters/cashiers

  reset_token            String?   @db.VarChar(64)
  reset_token_expires_at DateTime? @db.Timestamptz(6)
  is_active              Boolean?  @default(true)
  hired_at               DateTime? @db.Date // meaningful for staff, null otherwise

  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)

  staff_salaries         staff_salaries[]
  payslips               payslips[]             @relation("payslip_recipient")
  advances_received      staff_advances[]       @relation("advance_recipient")
  advances_approved      staff_advances[]       @relation("advance_approver")
  staff_attendance       staff_attendance[]
  expenses_created       expenses[]             @relation("expense_creator")
  expenses_approved      expenses[]             @relation("expense_approver")
  payroll_runs_processed payroll_runs[]         @relation("payroll_processor")
  leave_requests         staff_leave_requests[] @relation("leave_requester")
  leave_approved         staff_leave_requests[] @relation("leave_approver")

  stays_checked_in  room_stays[] @relation("stay_checkin")
  stays_checked_out room_stays[] @relation("stay_checkout")

  roles    roles     @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branches branches? @relation(fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  hotel_owners           hotel_owners[]
  inventory_transactions inventory_transactions[]
  order_discounts        order_discounts[]
  orders                 orders[]
  payments               payments[]
  pos_devices            pos_devices[]
  shifts                 shifts[]
  table_sessions         table_sessions[]

  @@index([branch_id], map: "idx_users_branch")
  @@index([role_id], map: "idx_users_role")
}

model roles {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String             @unique @db.VarChar(50) // super_admin, hotel_owner, branch_manager, waiter, cashier, kitchen, ...
  scope            String             @default("branch") @db.VarChar(20) // platform | hotel | branch
  role_permissions role_permissions[]
  users            users[]
}

model permissions {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String             @unique @db.VarChar(100)
  description      String?
  role_permissions role_permissions[]
}

model role_permissions {
  role_id       String      @db.Uuid
  permission_id String      @db.Uuid
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([role_id, permission_id])
}

// =========================================================
// BUYERS — online customers (self-signup, platform-wide)
// =========================================================

/// Online customers who order/book from the public web app.
/// Entirely separate from `customers` (which are POS walk-ins added
/// by staff, scoped per-hotel). A buyer logs in with email or phone
/// and can order at ANY hotel on the platform.
model buyers {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  full_name     String    @db.VarChar(150)
  email         String?   @unique @db.VarChar(150)
  phone         String?   @unique @db.VarChar(30)
  password_hash String
  is_active     Boolean?  @default(true)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_at    DateTime? @default(now()) @db.Timestamptz(6)

  orders     orders[]
  reviews    reviews[]
  room_stays room_stays[]
  payments   payments[]
}

// =========================================================
// PLATFORM / TENANCY
// =========================================================

/// This table contains check constraints and requires additional setup for migrations.
model hotels {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String @db.VarChar(150)
  slug String @unique @db.VarChar(150)

  logo_url                String?
  subscription_plan_id    String?   @db.Uuid
  subscription_status     String?   @default("trial")
  subscription_expires_at DateTime? @db.Timestamptz(6)
  is_online               Boolean   @default(false)
  created_at              DateTime? @default(now()) @db.Timestamptz(6)
  updated_at              DateTime? @default(now()) @db.Timestamptz(6)

  subscription_plans  subscription_plans?  @relation(fields: [subscription_plan_id], references: [id])
  verification_status String               @default("pending") @db.VarChar(20)
  // the single owner profile for this hotel (1-to-1)
  hotel_owner         hotel_owners?
  expense_categories  expense_categories[]

  branches   branches[]
  customers  customers[]
  audit_logs audit_logs[]
}

/// Hotel Owner profile — 1-to-1 with users, 1-to-1 with hotels.
/// user_id IS the primary key: this is a profile, not a separate login.
/// One user owns exactly one hotel; one hotel has exactly one owner.
model hotel_owners {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id  String  @unique @db.Uuid
  hotel_id String  @unique @db.Uuid
  address  String?

  hesabpay_account_number String?   @db.VarChar(30)
  created_at              DateTime? @default(now()) @db.Timestamptz(6)

  users  users  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  hotels hotels @relation(fields: [hotel_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model pending_signups {
  id                   String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscription_plan_id String  @db.Uuid
  hotel_name           String  @db.VarChar(150)
  owner_name           String  @db.VarChar(150)
  email                String  @db.VarChar(150)
  phone                String? @db.VarChar(30)

  reveal_password   String?   @db.VarChar(64)
  reveal_expires_at DateTime? @db.Timestamptz(6)

  status String @default("pending") @db.VarChar(20)

  hesabpay_session_id String? @db.VarChar(150)
  created_hotel_id    String? @db.Uuid

  created_at         DateTime?          @default(now()) @db.Timestamptz(6)
  paid_at            DateTime?          @db.Timestamptz(6)
  expires_at         DateTime?          @db.Timestamptz(6)
  subscription_plans subscription_plans @relation(fields: [subscription_plan_id], references: [id])

  @@index([subscription_plan_id], map: "idx_pending_signups_plan")
  @@index([status], map: "idx_pending_signups_status")
  @@index([expires_at], map: "idx_pending_signups_expires")
}

model email_verifications {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email       String    @db.VarChar(150)
  otp         String    @db.VarChar(6)
  attempts    Int       @default(0)
  expires_at  DateTime  @db.Timestamptz(6)
  verified_at DateTime? @db.Timestamptz(6)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)

  @@index([email], map: "idx_email_verifications_email")
}

model subscription_plans {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String            @db.VarChar(100)
  max_branches    Int               @default(1)
  max_pos_devices Int               @default(2)
  price_monthly   Decimal           @db.Decimal(12, 2)
  features        Json?             @default("{}")
  is_rooms        Boolean           @default(false)
  is_active       Boolean?          @default(true)
  created_at      DateTime?         @default(now()) @db.Timestamptz(6)
  hotels          hotels[]
  pending_signups pending_signups[]
}

// =========================================================
// PROVINCES — geographic reference data (platform-wide)
// =========================================================

model provinces {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String @unique @db.VarChar(100) // "Kabul", "Herat", "Balkh"...

  branches branches[]
}

/// This table contains check constraints and requires additional setup for migrations.
model branches {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotel_id            String    @db.Uuid
  province_id         String?   @db.Uuid
  name                String    @db.VarChar(150)
  code                String?   @db.VarChar(20)
  address             String?
  city                String?   @db.VarChar(100)
  phone               String?   @db.VarChar(30)
  latitude            Decimal?  @db.Decimal(10, 7)
  longitude           Decimal?  @db.Decimal(10, 7)
  currency            String?   @default("AFN") @db.VarChar(10)
  timezone            String?   @default("Asia/Kabul") @db.VarChar(50)
  tax_rate            Decimal?  @default(0) @db.Decimal(5, 2)
  service_charge_rate Decimal?  @default(0) @db.Decimal(5, 2)
  status              String?   @default("active") @db.VarChar(20)
  opening_time        DateTime? @db.Time(6)
  closing_time        DateTime? @db.Time(6)
  created_at          DateTime? @default(now()) @db.Timestamptz(6)
  updated_at          DateTime? @default(now()) @db.Timestamptz(6)

  expenses         expenses[]
  payroll_runs     payroll_runs[]
  staff_attendance staff_attendance[]

  hotels hotels @relation(fields: [hotel_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  provinces provinces? @relation(fields: [province_id], references: [id], onDelete: SetNull, onUpdate: NoAction) // ← NEW

  users                users[]
  audit_logs           audit_logs[]
  dining_areas         dining_areas[]
  dining_tables        dining_tables[]
  discounts            discounts[]
  inventory_items      inventory_items[]
  invoices             invoices[]
  menu_categories      menu_categories[]
  menu_items           menu_items[]
  orders               orders[]
  payment_methods      payment_methods[]
  pos_devices          pos_devices[]
  printers             printers[]
  shifts               shifts[]
  table_sessions       table_sessions[]
  staff_leave_requests staff_leave_requests[] @relation("branch_leave_requests")

  room_types room_types[]
  rooms      rooms[]
  room_stays room_stays[]

  reviews reviews[]

  @@unique([hotel_id, code])
  @@index([hotel_id], map: "idx_branches_hotel")
  @@index([province_id], map: "idx_branches_province") // ← NEW
}

// =========================================================
// AUDIT
// =========================================================

/// actor_id intentionally has no FK — audit rows must survive user deletion.
model audit_logs {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotel_id    String?   @db.Uuid
  branch_id   String?   @db.Uuid
  actor_id    String?   @db.Uuid
  actor_type  String?   @db.VarChar(20)
  action      String    @db.VarChar(100)
  entity_type String?   @db.VarChar(50)
  entity_id   String?   @db.Uuid
  metadata    Json?     @default("{}")
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  branches    branches? @relation(fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  hotels      hotels?   @relation(fields: [hotel_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([branch_id], map: "idx_audit_branch")
  @@index([hotel_id], map: "idx_audit_hotel")
}

// =========================================================
// FLOOR / DINING
// =========================================================

/// Local walk-in customer added by staff at POS. Per-hotel. No login.
/// Online buyers are stored in `buyers` — they are separate identities.
model customers {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotel_id       String    @db.Uuid
  full_name      String?   @db.VarChar(150)
  phone          String?   @db.VarChar(30)
  email          String?   @db.VarChar(150)
  loyalty_points Int?      @default(0)
  notes          String?
  created_at     DateTime? @default(now()) @db.Timestamptz(6)

  hotels hotels @relation(fields: [hotel_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  orders     orders[]
  room_stays room_stays[]
  payments   payments[]

  @@unique([hotel_id, phone])
}

model dining_areas {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branch_id     String          @db.Uuid
  name          String          @db.VarChar(100)
  branches      branches        @relation(fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  dining_tables dining_tables[]
}

model dining_tables {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branch_id      String           @db.Uuid
  area_id        String?          @db.Uuid
  table_number   String           @db.VarChar(20)
  capacity       Int?             @default(4)
  status         String?          @default("available") @db.VarChar(20)
  qr_code_token  String?          @unique @db.VarChar(100)
  created_at     DateTime?        @default(now()) @db.Timestamptz(6)
  dining_areas   dining_areas?    @relation(fields: [area_id], references: [id], onUpdate: NoAction)
  branches       branches         @relation(fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  table_sessions table_sessions[]

  @@unique([branch_id, table_number])
  @@index([branch_id], map: "idx_tables_branch")
}

model table_sessions {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  table_id      String        @db.Uuid
  branch_id     String        @db.Uuid
  opened_by     String?       @db.Uuid
  guest_count   Int?          @default(1)
  status        String?       @default("open") @db.VarChar(20)
  opened_at     DateTime?     @default(now()) @db.Timestamptz(6)
  closed_at     DateTime?     @db.Timestamptz(6)
  orders        orders[]
  branches      branches      @relation(fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users         users?        @relation(fields: [opened_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dining_tables dining_tables @relation(fields: [table_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([table_id], map: "idx_sessions_table")
}

// =========================================================
// MENU
// =========================================================

model menu_categories {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branch_id  String       @db.Uuid
  name       String       @db.VarChar(100)
  sort_order Int?         @default(0)
  is_active  Boolean?     @default(true)
  branches   branches     @relation(fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  menu_items menu_items[]
}

model menu_items {
  id                        String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branch_id                 String                      @db.Uuid
  category_id               String?                     @db.Uuid
  name                      String                      @db.VarChar(150)
  description               String?
  image_url                 String?
  price                     Decimal                     @db.Decimal(12, 2)
  tax_rate                  Decimal?                    @default(0) @db.Decimal(5, 2)
  is_available              Boolean?                    @default(true)
  is_online                 Boolean                     @default(false)
  is_kitchen                Boolean?                    @default(true)
  prep_station              String?                     @db.VarChar(50)
  sort_order                Int?                        @default(0)
  created_at                DateTime?                   @default(now()) @db.Timestamptz(6)
  updated_at                DateTime?                   @default(now()) @db.Timestamptz(6)
  menu_item_ingredients     menu_item_ingredients[]
  menu_item_modifier_groups menu_item_modifier_groups[]
  branches                  branches                    @relation(fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  menu_categories           menu_categories?            @relation(fields: [category_id], references: [id], onUpdate: NoAction)
  order_items               order_items[]
  reviews                   reviews[]

  @@index([branch_id], map: "idx_menu_items_branch")
  @@index([category_id], map: "idx_menu_items_category")
  @@index([branch_id, is_available, is_online], map: "idx_menu_items_public")
}

model menu_item_modifier_groups {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  menu_item_id        String                @db.Uuid
  name                String                @db.VarChar(100)
  is_required         Boolean?              @default(false)
  max_selectable      Int?                  @default(1)
  menu_items          menu_items            @relation(fields: [menu_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  menu_item_modifiers menu_item_modifiers[]
}

model menu_item_modifiers {
  id                        String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id                  String                    @db.Uuid
  name                      String                    @db.VarChar(100)
  extra_price               Decimal?                  @default(0) @db.Decimal(12, 2)
  menu_item_modifier_groups menu_item_modifier_groups @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

// =========================================================
// INVENTORY
// =========================================================

model inventory_items {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branch_id              String                   @db.Uuid
  name                   String                   @db.VarChar(150)
  unit                   String?                  @db.VarChar(20)
  quantity_on_hand       Decimal?                 @default(0) @db.Decimal(12, 3)
  reorder_level          Decimal?                 @default(0) @db.Decimal(12, 3)
  updated_at             DateTime?                @default(now()) @db.Timestamptz(6)
  branches               branches                 @relation(fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  inventory_transactions inventory_transactions[]
  menu_item_ingredients  menu_item_ingredients[]
}

model menu_item_ingredients {
  menu_item_id      String          @db.Uuid
  inventory_item_id String          @db.Uuid
  quantity_required Decimal         @db.Decimal(12, 3)
  inventory_items   inventory_items @relation(fields: [inventory_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  menu_items        menu_items      @relation(fields: [menu_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([menu_item_id, inventory_item_id])
}

model inventory_transactions {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inventory_item_id  String          @db.Uuid
  change_type        String?         @db.VarChar(20)
  quantity_change    Decimal         @db.Decimal(12, 3)
  reference_order_id String?         @db.Uuid
  created_by         String?         @db.Uuid
  created_at         DateTime?       @default(now()) @db.Timestamptz(6)
  users              users?          @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inventory_items    inventory_items @relation(fields: [inventory_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orders             orders?         @relation(fields: [reference_order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

// =========================================================
// ORDERS / KITCHEN
// =========================================================

/// An order is EITHER a POS order (customer_id set, buyer_id null)
/// OR an online order (buyer_id set, customer_id null). Never both.
model orders {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branch_id         String    @db.Uuid
  table_session_id  String?   @db.Uuid
  customer_id       String?   @db.Uuid
  buyer_id          String?   @db.Uuid
  room_stay_id      String?   @db.Uuid
  order_number      String    @db.VarChar(30)
  order_type        String    @default("dine_in") @db.VarChar(20)
  status            String    @default("open") @db.VarChar(20)
  waiter_id         String?   @db.Uuid
  subtotal          Decimal   @default(0) @db.Decimal(12, 2)
  discount_amount   Decimal   @default(0) @db.Decimal(12, 2)
  tax_amount        Decimal   @default(0) @db.Decimal(12, 2)
  service_charge    Decimal   @default(0) @db.Decimal(12, 2)
  total_amount      Decimal   @default(0) @db.Decimal(12, 2)
  notes             String?
  source            String?   @default("pos") @db.VarChar(20) // pos | customer | qr
  public_token      String?   @unique @db.VarChar(64)
  created_at        DateTime? @default(now()) @db.Timestamptz(6)
  updated_at        DateTime? @default(now()) @db.Timestamptz(6)
  payment_status    String?   @default("unpaid") @db.VarChar(20) // unpaid | paid | failed | refunded
  payment_reference String?   @db.VarChar(150) // HesabPay session/transaction id
  paid_at           DateTime? @db.Timestamptz(6)

  payout                 order_payouts?
  inventory_transactions inventory_transactions[]
  invoices               invoices[]
  kitchen_tickets        kitchen_tickets[]
  order_discounts        order_discounts[]
  order_items            order_items[]
  reviews                reviews[]

  branches       branches        @relation(fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  customers      customers?      @relation(fields: [customer_id], references: [id], onUpdate: NoAction)
  buyers         buyers?         @relation(fields: [buyer_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  table_sessions table_sessions? @relation(fields: [table_session_id], references: [id], onUpdate: NoAction)
  room_stays     room_stays?     @relation(fields: [room_stay_id], references: [id], onUpdate: NoAction)
  users          users?          @relation(fields: [waiter_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payments       payments[]

  @@unique([branch_id, order_number])
  @@index([branch_id], map: "idx_orders_branch")
  @@index([table_session_id], map: "idx_orders_session")
  @@index([room_stay_id], map: "idx_orders_room_stay")
  @@index([status], map: "idx_orders_status")
  @@index([source], map: "idx_orders_source")
  @@index([buyer_id], map: "idx_orders_buyer")
}

model platform_settings {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  commission_rate    Decimal  @default(5.00) @db.Decimal(5, 2) // %
  commission_account String?  @db.VarChar(30) // where the 5% goes (optional — see note below)
  updated_at         DateTime @default(now()) @db.Timestamptz(6)
}

// Payout ledger — one row per order payment distribution
model order_payouts {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id           String    @unique @db.Uuid
  hotel_id           String    @db.Uuid
  owner_account      String    @db.VarChar(30)
  commission_account String?   @db.VarChar(30)
  gross_amount       Decimal   @db.Decimal(12, 2)
  platform_fee       Decimal   @db.Decimal(12, 2)
  owner_amount       Decimal   @db.Decimal(12, 2)
  status             String    @default("pending") @db.VarChar(20) // pending | completed | failed
  transaction_id     String?   @db.VarChar(150)
  error_message      String?
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  completed_at       DateTime? @db.Timestamptz(6)

  orders orders @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([hotel_id])
  @@index([status])
}

model order_items {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id             String                 @db.Uuid
  menu_item_id         String                 @db.Uuid
  quantity             Int                    @default(1)
  unit_price           Decimal                @db.Decimal(12, 2)
  modifiers            Json?                  @default("[]")
  line_total           Decimal                @db.Decimal(12, 2)
  notes                String?
  status               String?                @default("pending") @db.VarChar(20)
  created_at           DateTime?              @default(now()) @db.Timestamptz(6)
  kitchen_ticket_items kitchen_ticket_items[]
  menu_items           menu_items             @relation(fields: [menu_item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orders               orders                 @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([order_id], map: "idx_order_items_order")
  @@index([menu_item_id], map: "idx_order_items_menu_item")
}

model kitchen_ticket_items {
  kitchen_ticket_id String          @db.Uuid
  order_item_id     String          @db.Uuid
  kitchen_tickets   kitchen_tickets @relation(fields: [kitchen_ticket_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  order_items       order_items     @relation(fields: [order_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([kitchen_ticket_id, order_item_id])
}

model kitchen_tickets {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id             String                 @db.Uuid
  prep_station         String?                @db.VarChar(50)
  printed_at           DateTime?              @db.Timestamptz(6)
  status               String?                @default("queued") @db.VarChar(20)
  created_at           DateTime?              @default(now()) @db.Timestamptz(6)
  kitchen_ticket_items kitchen_ticket_items[]
  orders               orders                 @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

// =========================================================
// REVIEWS — only online buyers can review
// =========================================================

/// A review is always written by a logged-in buyer (self-signup,
/// platform-wide). POS walk-in customers CANNOT review — no
/// `customer_id` field on purpose. `order_id` links the review
/// back to the specific order the buyer placed.
model reviews {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  menu_item_id String    @db.Uuid
  branch_id    String    @db.Uuid
  order_id     String?   @db.Uuid
  buyer_id     String    @db.Uuid
  rating       Int // 1..5
  comment      String?
  created_at   DateTime? @default(now()) @db.Timestamptz(6)

  menu_items menu_items @relation(fields: [menu_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  branches   branches   @relation(fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orders     orders?    @relation(fields: [order_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  buyers     buyers     @relation(fields: [buyer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([menu_item_id], map: "idx_reviews_item")
  @@index([branch_id], map: "idx_reviews_branch")
  @@index([buyer_id], map: "idx_reviews_buyer")
  @@index([rating], map: "idx_reviews_rating")
}

// =========================================================
// DISCOUNTS / PAYMENTS / INVOICES
// =========================================================

model discounts {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branch_id         String            @db.Uuid
  name              String?           @db.VarChar(100)
  type              String?           @db.VarChar(10)
  value             Decimal           @db.Decimal(12, 2)
  requires_approval Boolean?          @default(false)
  is_active         Boolean?          @default(true)
  branches          branches          @relation(fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  order_discounts   order_discounts[]
}

model order_discounts {
  order_id       String    @db.Uuid
  discount_id    String    @db.Uuid
  applied_by     String?   @db.Uuid
  amount_applied Decimal   @db.Decimal(12, 2)
  users          users?    @relation(fields: [applied_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  discounts      discounts @relation(fields: [discount_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orders         orders    @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([order_id, discount_id])
}

model payment_methods {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branch_id       String     @db.Uuid
  name            String     @db.VarChar(50)
  type            String     @db.VarChar(20)
  provider_config Json?      @default("{}")
  is_active       Boolean?   @default(true)
  branches        branches   @relation(fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  payments        payments[]
  expenses        expenses[]
}

model payments {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id          String?   @db.Uuid
  room_stay_id      String?   @db.Uuid
  customer_id       String?   @db.Uuid
  buyer_id          String?   @db.Uuid
  payment_method_id String    @db.Uuid
  amount            Decimal   @db.Decimal(12, 2)
  amount_tendered   Decimal?  @db.Decimal(12, 2)
  change_given      Decimal?  @default(0) @db.Decimal(12, 2)
  status            String?   @default("completed") @db.VarChar(20)
  transaction_ref   String?   @db.VarChar(150)
  received_by       String?   @db.Uuid
  paid_at           DateTime? @default(now()) @db.Timestamptz(6)
  notes             String?

  orders          orders?         @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  room_stays      room_stays?     @relation(fields: [room_stay_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  customers       customers?      @relation(fields: [customer_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  buyers          buyers?         @relation(fields: [buyer_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  payment_methods payment_methods @relation(fields: [payment_method_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users           users?          @relation(fields: [received_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([order_id], map: "idx_payments_order")
  @@index([room_stay_id], map: "idx_payments_room_stay")
  @@index([customer_id], map: "idx_payments_customer")
  @@index([buyer_id], map: "idx_payments_buyer")
}

model invoices {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id        String    @db.Uuid
  branch_id       String    @db.Uuid
  invoice_number  String    @db.VarChar(30)
  subtotal        Decimal   @db.Decimal(12, 2)
  discount_amount Decimal   @default(0) @db.Decimal(12, 2)
  tax_amount      Decimal   @default(0) @db.Decimal(12, 2)
  service_charge  Decimal   @default(0) @db.Decimal(12, 2)
  total_amount    Decimal   @db.Decimal(12, 2)
  printed_count   Int?      @default(0)
  pdf_url         String?
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  branches        branches  @relation(fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orders          orders    @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([branch_id, invoice_number])
}

// =========================================================
// DEVICES / SHIFTS
// =========================================================

model pos_devices {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branch_id         String    @db.Uuid
  device_name       String?   @db.VarChar(100)
  device_uid        String?   @unique @db.VarChar(150)
  device_type       String?   @default("mobile_pos") @db.VarChar(20)
  assigned_staff_id String?   @db.Uuid
  last_seen_at      DateTime? @db.Timestamptz(6)
  is_active         Boolean?  @default(true)
  created_at        DateTime? @default(now()) @db.Timestamptz(6)
  users             users?    @relation(fields: [assigned_staff_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branches          branches  @relation(fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model printers {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branch_id          String   @db.Uuid
  name               String?  @db.VarChar(100)
  printer_type       String?  @default("receipt") @db.VarChar(20)
  connection_type    String?  @default("bluetooth") @db.VarChar(20)
  connection_address String?  @db.VarChar(150)
  prep_station       String?  @db.VarChar(50)
  is_active          Boolean? @default(true)
  branches           branches @relation(fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model shifts {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branch_id     String    @db.Uuid
  staff_id      String    @db.Uuid
  opening_cash  Decimal?  @default(0) @db.Decimal(12, 2)
  closing_cash  Decimal?  @default(0) @db.Decimal(12, 2)
  expected_cash Decimal?  @default(0) @db.Decimal(12, 2)
  variance      Decimal?  @default(0) @db.Decimal(12, 2)
  started_at    DateTime? @default(now()) @db.Timestamptz(6)
  ended_at      DateTime? @db.Timestamptz(6)
  status        String?   @default("open") @db.VarChar(20)
  branches      branches  @relation(fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users         users     @relation(fields: [staff_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

// =========================================================
// LEAVE REQUESTS
// =========================================================

model staff_leave_requests {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String    @db.Uuid
  branch_id   String    @db.Uuid
  leave_type  String    @db.VarChar(30)
  start_date  DateTime  @db.Date
  end_date    DateTime  @db.Date
  reason      String?
  status      String    @default("pending") @db.VarChar(20)
  approved_by String?   @db.Uuid
  approved_at DateTime? @db.Timestamptz(6)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @default(now()) @db.Timestamptz(6)

  user     users    @relation("leave_requester", fields: [user_id], references: [id], onDelete: Cascade)
  branch   branches @relation("branch_leave_requests", fields: [branch_id], references: [id], onDelete: Cascade)
  approver users?   @relation("leave_approver", fields: [approved_by], references: [id])

  @@index([user_id])
  @@index([branch_id])
  @@index([status])
}

// =========================================================
// EXPENSES
// =========================================================

/// Category bucket for expenses (Rent, Utilities, Maintenance, Supplies...)
/// Scoped at hotel level so all branches of a hotel share the same categories.
model expense_categories {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotel_id    String   @db.Uuid
  name        String   @db.VarChar(100)
  description String?
  is_active   Boolean? @default(true)

  hotels   hotels     @relation(fields: [hotel_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  expenses expenses[]

  @@unique([hotel_id, name])
}

/// Day-to-day operating expenses for a branch (rent, utilities, repairs,
/// supplier purchases that aren't inventory, etc). Distinct from
/// staff payroll, which lives in payslips below.
model expenses {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branch_id         String  @db.Uuid
  category_id       String? @db.Uuid
  payment_method_id String? @db.Uuid

  title       String  @db.VarChar(150)
  description String?
  amount      Decimal @db.Decimal(12, 2)
  vendor_name String? @db.VarChar(150)
  receipt_url String?

  expense_date DateTime @default(now()) @db.Date
  status       String?  @default("pending") @db.VarChar(20) // pending | approved | rejected | paid

  is_recurring        Boolean? @default(false)
  recurrence_interval String?  @db.VarChar(20)

  created_by  String?   @db.Uuid
  approved_by String?   @db.Uuid
  approved_at DateTime? @db.Timestamptz(6)

  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)

  branches           branches            @relation(fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  expense_categories expense_categories? @relation(fields: [category_id], references: [id], onUpdate: NoAction)
  payment_methods    payment_methods?    @relation(fields: [payment_method_id], references: [id], onUpdate: NoAction)

  creator  users? @relation("expense_creator", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approver users? @relation("expense_approver", fields: [approved_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([branch_id], map: "idx_expenses_branch")
  @@index([category_id], map: "idx_expenses_category")
  @@index([status], map: "idx_expenses_status")
  @@index([expense_date], map: "idx_expenses_date")
}

// =========================================================
// HR / PAYROLL
// =========================================================

/// Current + historical salary structure per staff member.
/// Keep old rows (is_current = false) instead of overwriting, so payroll
/// history stays accurate even after a raise.
model staff_salaries {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String    @db.Uuid
  salary_type    String    @default("monthly") @db.VarChar(20) // monthly | hourly | daily
  base_amount    Decimal   @db.Decimal(12, 2)
  bonus_amount   Decimal?  @default(0) @db.Decimal(12, 2)
  currency       String?   @default("AFN") @db.VarChar(10)
  effective_from DateTime  @db.Date
  effective_to   DateTime? @db.Date
  is_current     Boolean?  @default(true)
  created_at     DateTime? @default(now()) @db.Timestamptz(6)

  users users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_staff_salaries_user")
}

/// One payroll batch per branch per pay period (e.g. "August 2026").
model payroll_runs {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branch_id    String    @db.Uuid
  period_start DateTime  @db.Date
  period_end   DateTime  @db.Date
  status       String?   @default("draft") @db.VarChar(20) // draft | processed | paid
  processed_by String?   @db.Uuid
  processed_at DateTime? @db.Timestamptz(6)
  created_at   DateTime? @default(now()) @db.Timestamptz(6)

  branches  branches   @relation(fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  processor users?     @relation("payroll_processor", fields: [processed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payslips  payslips[]

  @@unique([branch_id, period_start, period_end])
  @@index([branch_id], map: "idx_payroll_runs_branch")
}

/// One line per staff member within a payroll run — the actual amount paid.
model payslips {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payroll_run_id String @db.Uuid
  user_id        String @db.Uuid

  base_salary      Decimal  @db.Decimal(12, 2)
  bonus_amount     Decimal? @default(0) @db.Decimal(12, 2)
  deduction_amount Decimal? @default(0) @db.Decimal(12, 2)
  advance_deducted Decimal? @default(0) @db.Decimal(12, 2)
  net_pay          Decimal  @db.Decimal(12, 2)

  status  String?   @default("unpaid") @db.VarChar(20) // unpaid | paid
  paid_at DateTime? @db.Timestamptz(6)
  notes   String?

  payroll_runs payroll_runs @relation(fields: [payroll_run_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users        users        @relation("payslip_recipient", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([payroll_run_id, user_id])
  @@index([user_id], map: "idx_payslips_user")
}

/// Salary advances / loans given to staff, later deducted from a payslip.
model staff_advances {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String    @db.Uuid
  amount       Decimal   @db.Decimal(12, 2)
  reason       String?
  status       String?   @default("pending") @db.VarChar(20) // pending | approved | repaid | rejected
  requested_at DateTime? @default(now()) @db.Timestamptz(6)
  approved_by  String?   @db.Uuid

  recipient users  @relation("advance_recipient", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  approver  users? @relation("advance_approver", fields: [approved_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id], map: "idx_advances_user")
}

model tutorials {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  language    String    @db.VarChar(10)
  category    String    @db.VarChar(100)
  title       String    @db.VarChar(200)
  description String?
  youtube_id  String    @db.VarChar(50)
  duration    String?   @db.VarChar(20)
  sort_order  Int?      @default(0)
  is_active   Boolean?  @default(true)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @default(now()) @db.Timestamptz(6)

  @@index([language], map: "idx_tutorials_language")
  @@index([is_active], map: "idx_tutorials_active")
}

/// Clock-in/out records used to compute payroll deductions.
model staff_attendance {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id   String    @db.Uuid
  branch_id String    @db.Uuid
  check_in  DateTime  @db.Timestamptz(6)
  check_out DateTime? @db.Timestamptz(6)
  status    String?   @default("present") @db.VarChar(20) // present | absent | late | leave
  notes     String?

  users    users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  branches branches @relation(fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_attendance_user")
  @@index([branch_id], map: "idx_attendance_branch")
}

// =========================================================
// ROOMS — walk-in assignment, rent + running orders
// =========================================================

/// Physical room types configured per branch (Double, VIP, Single...).
model room_types {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branch_id  String   @db.Uuid
  name       String   @db.VarChar(100)
  base_price Decimal  @db.Decimal(12, 2)
  capacity   Int      @default(2)
  is_active  Boolean? @default(true)

  branches branches @relation(fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  rooms    rooms[]

  @@index([branch_id], map: "idx_room_types_branch")
}

/// One row per physical room in a branch.
/// status: available | occupied | cleaning | maintenance
model rooms {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branch_id    String    @db.Uuid
  room_type_id String    @db.Uuid
  room_number  String    @db.VarChar(20)
  floor        String?   @db.VarChar(20)
  status       String    @default("available") @db.VarChar(20)
  notes        String?
  is_active    Boolean?  @default(true)
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  updated_at   DateTime? @default(now()) @db.Timestamptz(6)

  branches   branches     @relation(fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  room_types room_types   @relation(fields: [room_type_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  room_stays room_stays[]

  @@unique([branch_id, room_number])
  @@index([branch_id], map: "idx_rooms_branch")
  @@index([status], map: "idx_rooms_status")
}

/// A running stay for one room. Can be assigned to a POS customer
/// (staff-checked-in walk-in) OR to an online buyer (self-booked).
/// Exactly one of customer_id / buyer_id is set.
model room_stays {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branch_id String @db.Uuid
  room_id   String @db.Uuid

  customer_id String? @db.Uuid
  buyer_id    String? @db.Uuid
  guest_name  String? @db.VarChar(150)
  guest_phone String? @db.VarChar(30)
  guest_id_no String? @db.VarChar(60)

  check_in_at        DateTime  @default(now()) @db.Timestamptz(6)
  expected_check_out DateTime? @db.Date
  actual_check_out   DateTime? @db.Timestamptz(6)

  rate_per_night Decimal @db.Decimal(12, 2)
  nights         Int     @default(1)
  rent_total     Decimal @default(0) @db.Decimal(12, 2)
  orders_total   Decimal @default(0) @db.Decimal(12, 2)
  grand_total    Decimal @default(0) @db.Decimal(12, 2)
  paid_amount    Decimal @default(0) @db.Decimal(12, 2)

  status  String  @default("active") @db.VarChar(20)
  is_paid Boolean @default(false)

  checked_in_by  String? @db.Uuid
  checked_out_by String? @db.Uuid
  notes          String?

  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)

  branches    branches   @relation(fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  rooms       rooms      @relation(fields: [room_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  customers   customers? @relation(fields: [customer_id], references: [id], onUpdate: NoAction)
  buyers      buyers?    @relation(fields: [buyer_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  checked_in  users?     @relation("stay_checkin", fields: [checked_in_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  checked_out users?     @relation("stay_checkout", fields: [checked_out_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  orders   orders[]
  payments payments[]

  @@index([branch_id], map: "idx_stays_branch")
  @@index([room_id], map: "idx_stays_room")
  @@index([status], map: "idx_stays_status")
  @@index([buyer_id], map: "idx_stays_buyer")
}
