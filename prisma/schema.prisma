generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"

 
}

enum VehicleType {
  DUMP_TRUCK
  TANKER
  EXCAVATOR
  TAXI
  BODY_TRUCK
}


enum Role {
  SUPERADMIN
  ADMIN
  STAFF
}

enum VehicleStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
  OUT_OF_SERVICE
}

enum FuelType {
  DIESEL
  GASOLINE
  ELECTRIC
  HYBRID
}

// ---------- PROVINCE ----------
model Province {
  id       String    @id @default(cuid())
  name     String    @unique
  vehicles Vehicle[]
}

// ---------- BASE VEHICLE ----------
model Vehicle {
  id             String        @id @default(cuid())
  type           VehicleType
  brand          String?
  model          String?
  year           Int?
  plateNumber    String?       @unique
  vin            String?       @unique
  fuelType       FuelType?
  transmission   String?

  status         VehicleStatus @default(AVAILABLE)
  pricePerDay    Float?
  pricePerHour   Float?
  images         String[]
  description    String?


  owner         Owner?       @relation(fields: [ownerId], references: [id])
  ownerId       String?


  province       Province?     @relation(fields: [provinceId], references: [id])
  provinceId     String?

   orders        Order[]

  dumpTruck      DumpTruck?
  tanker         Tanker?
  excavator      Excavator?
  taxi           Taxi?
  bodyTruck      BodyTruck?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

// ---------- DUMP TRUCK ----------
model DumpTruck {
  id            String   @id @default(cuid())
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId     String   @unique

  bedType       String?
  bedCapacity   Float?
  capacityUnit  String?
  payloadWeight Float?
  axleCount     Int?
  dumpAngle     Float?
  gvwr          Float?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ---------- TANKER ----------
model Tanker {
  id            String   @id @default(cuid())
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId     String   @unique

  tankCapacity  Float?
  capacityUnit  String?
  tankMaterial  String?
  compartments  Int?
  insulated     Boolean  @default(false)
  pumpType      String?
  liquidType    String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ---------- EXCAVATOR ----------
model Excavator {
  id              String   @id @default(cuid())
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId       String   @unique

  boomLength      Float?
  bucketCapacity  Float?
  diggingDepth    Float?
  operatingWeight Float?
  trackType       String?
  engineHP        Float?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ---------- TAXI ----------
model Taxi {
  id               String   @id @default(cuid())
  vehicle          Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId        String   @unique

  seats            Int?
  luggageCapacity  Int?
  hasMeter         Boolean  @default(true)
  licenseClass     String?
  ac               Boolean  @default(true)
  color            String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}





model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(STAFF)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

    ordersCreated Order[]

  @@map("users")
}


// ---------- BODY TRUCK ----------
model BodyTruck {
  id            String   @id @default(cuid())
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId     String   @unique

  bodyType      String?
  cargoLength   Float?
  cargoWidth    Float?
  cargoHeight   Float?
  maxPayload    Float?
  hasLiftgate   Boolean  @default(false)
  refrigerated  Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}




// ---------- OWNER ----------
model Owner {
  id             String    @id @default(cuid())
  name           String
  phone          String?  @unique
  password       String?
  address        String?
  tazkiraNumber  String?   @unique  
  notes          String?

  vehicles       Vehicle[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ---------- CLIENT (renter) ----------
model Client {
  id        String    @id @default(cuid())
  name      String
  phone     String?
  email     String?   @unique
  address   String?
  // optional: driver license, company, etc.
  notes     String?

  orders    Order[]   // orders placed by this client

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ---------- ORDER STATUS ENUM ----------
enum OrderStatus {
  PENDING
  CONFIRMED
  ACTIVE      // rental in progress
  COMPLETED
  CANCELLED
}

// ---------- ORDER ----------
model Order {
  id            String       @id @default(cuid())
  vehicleId     String
  clientId      String
  startDate     DateTime
  endDate       DateTime
  totalPrice    Float?       // can be calculated or manually set
  status        OrderStatus  @default(PENDING)
  notes         String?

  // optional: who created the order (admin/staff)
  createdById   String?      // references User
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // relations
  vehicle       Vehicle      @relation(fields: [vehicleId], references: [id])
  client        Client       @relation(fields: [clientId], references: [id])

  createdBy     User?  @relation(fields: [createdById], references: [id])

  @@index([vehicleId])
  @@index([clientId])
  @@index([status])
}
